{
  "name": "q-voice-token-server",
  "version": "0.1.0",
  "private": true,
  "description": "Issues LiveKit tokens only to players actually in the game a room name derives from",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/index.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\" \"test/*.mjs\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
