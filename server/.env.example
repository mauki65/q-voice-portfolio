# Riot production API key. Server-side only — never ships in any client.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# LiveKit. The secret is server-side only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

PORT=8080

# People allowed in one room. 0 disables the cap.
MAX_SEATS=5

# DEVELOPMENT ONLY. Skips Riot verification and hands a token to anyone who asks.
# The server refuses to start if this is set while NODE_ENV=production.
# QVOICE_DEV_BYPASS_VERIFICATION=true
